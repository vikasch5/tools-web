# Apache settings for the static site in build/client.
# Point the domain's document root at frontend/build/client.

# The PDF tools load ES-module workers (.mjs) and WebAssembly (.wasm);
# older Apache versions serve these with the wrong type, and browsers
# then refuse to run them.
AddType text/javascript .mjs
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Prerendered pages live at /<path>/index.html; serve them with or
  # without a trailing slash.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]
  # Anything else that is not a real file is handled by the app,
  # which shows its own "page not found" screen.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ __spa-fallback.html [L]
</IfModule>

# Built files have content hashes in their names, so they can be cached
# for a year; pages are always checked again.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
